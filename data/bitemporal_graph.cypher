MERGE (d:DecisionState {edge_id: "IS1009_edge_008"}) SET d.team_id = "IS1009", d.meeting_id = "IS1009b", d.topic = "IS1009_ent_target_group", d.decision_value = "In IS1009b, the team decides that the target group is everybody who owns a TV, addressing subgroups (children, elderly) through ergonomic shapes and button design if budget permits.", d.status = "ACCEPTED", d.speaker_id = "A", d.valid_from = 2.0, d.invalid_at = null, d.created_at = "2026-11-15T02:27:50.890898+00:00", d.semantic_target_quote = "But I think I I think to sum it up the target group is basically everybody. If money permits we can address some features";
